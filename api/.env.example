JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Supabase credentials (service environment only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_RESET_REDIRECT_URL="https://app.cooksmart.dev/reset-password"

# AWS / Textract
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
TEXTRACT_BUCKET="cooksmart-ocr-uploads"
TEXTRACT_USE_S3="true"
TEXTRACT_MAX_FILE_SIZE_MB="10"
OCR_METRICS_INTERVAL_MS="300000"
