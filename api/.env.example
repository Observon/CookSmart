# PostgreSQL connection string example
# Replace with actual credentials in your local .env file
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cooksmart?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# AWS / Textract
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
TEXTRACT_BUCKET="cooksmart-ocr-uploads"
TEXTRACT_USE_S3="true"
TEXTRACT_MAX_FILE_SIZE_MB="10"
OCR_METRICS_INTERVAL_MS="300000"
